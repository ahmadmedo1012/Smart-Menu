# Created by Vercel CLI
DATABASE_SCHEMA="public"
DATABASE_URL="postgresql://user:password@host:port/db"
JWT_SECRET="your-random-64-char-hex"
NEXT_PUBLIC_DOMAIN="https://your-domain.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="+1234567890"
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-chat-id"
TELEGRAM_ADMIN_IDS="comma-separated-admin-ids"
TELEGRAM_WEBHOOK_SECRET="your-telegram-webhook-secret"
# round86-D8: payment-approval broadcast target group ids (comma-separated)
# TELEGRAM_GROUP_IDS="123456,-100789"
# round86-D8: bot username for the admin deep-link (api/admin/telegram/link)
# TELEGRAM_BOT_USERNAME="your_bot"
AUTH_SECRET="your-random-64-char-hex"
PORT=3000
CRON_SECRET=your-cron-secret-here
# Required by /api/upload (Vercel Blob image storage) — round85-A6 added it here
BLOB_READ_WRITE_TOKEN="your-vercel-blob-read-write-token"
# round86-D8: required by /api/seed (throws when unset) — local bootstrap only
# ADMIN_PASSWORD="bootstrap-admin-password"
# round86-D8: override the seed admin account (defaults: admin / from scripts)
# SEED_ADMIN_USER="admin"
# SEED_ADMIN_PASS="change-me"
# round86-D8: explicitly allow seeding into a production DATABASE_URL (guards
# in ci-seed.mjs + round83-seed.mjs refuse without it)
# ALLOW_SEED=true
# round86-D8: used by `pnpm run webhook:register` (scripts/register-webhook.mjs)
# WEBHOOK_URL="https://your-domain.com/api/telegram/webhook"
# round86-D8: scratch database for `prisma migrate dev/diff` (never in prod)
# SHADOW_DATABASE_URL="postgresql://user:password@host:port/db_shadow"
# Dev-only: 1 enables relaxed per-IP rate limits (max * 200) for local e2e suites
# that share one origin across many projects. Never set in production.
# RATE_LIMIT_RELAX=1
# Optional override for the pg pool size. Auto-detected by default: 5 on Vercel,
# 5 when DATABASE_URL points at a remote host (Neon/pooler), 10 for a local DB.
# DATABASE_POOL_MAX=5

 # Skip startup env validation (CI/embedded-postgres local runs only — NEVER in production)
# SKIP_ENV_CHECK=true
