# Created by Vercel CLI
DATABASE_SCHEMA="public"
DATABASE_URL="postgresql://user:password@host:port/db"
JWT_SECRET="your-random-64-char-hex"
NEXT_PUBLIC_DOMAIN="https://your-domain.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="+1234567890"
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-chat-id"
TELEGRAM_ADMIN_IDS="comma-separated-admin-ids"
TELEGRAM_WEBHOOK_SECRET="your-telegram-webhook-secret"
AUTH_SECRET="your-random-64-char-hex"
PORT=3002
CRON_SECRET=your-cron-secret-here
# Required by /api/upload (Vercel Blob image storage) — round85-A6 added it here
BLOB_READ_WRITE_TOKEN="your-vercel-blob-read-write-token"
# Dev-only: 1 enables relaxed per-IP rate limits (max * 200) for local e2e suites
# that share one origin across many projects. Never set in production.
# RATE_LIMIT_RELAX=1
# Optional override for the pg pool size. Auto-detected by default: 5 on Vercel,
# 5 when DATABASE_URL points at a remote host (Neon/pooler), 10 for a local DB.
# DATABASE_POOL_MAX=5
