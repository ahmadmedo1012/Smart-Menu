# Smart Menu mobile app — environment overrides (all OPTIONAL, production defaults baked in).
# Copy to mobile/.env to override. EXPO_PUBLIC_* vars are INLINED at build time
# (expo export / EAS build) — changing them requires a rebuild, not just a restart.
# See mobile/README.md § Environment variables.

# Base URL of the Smart-Menu API the app talks to.
# Production default: https://menu.smart-link.ly
# Point a local build at your dev machine's web server instead (device/emulator
# cannot reach localhost):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:3000
EXPO_PUBLIC_API_BASE_URL=https://menu.smart-link.ly

# Public web domain used for share links, the order-confirmed page link and the
# owner menu-CRUD web redirect. Production default: https://menu.smart-link.ly
EXPO_PUBLIC_DOMAIN=https://menu.smart-link.ly

# WhatsApp number offered for support (login screen + floating button),
# E.164 international format. Production default: +218910089975
EXPO_PUBLIC_WHATSAPP_NUMBER=+218910089975
