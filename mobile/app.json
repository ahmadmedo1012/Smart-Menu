{
  "expo": {
    "name": "الربط الذكي | Smart Menu",
    "slug": "smart-menu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smartmenu",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ly.smartlink.smartmenu",
      "infoPlist": {
        "CFBundleLocalizations": ["ar", "en"],
        "CFBundleDevelopmentRegion": "ar",
        "NSCameraUsageDescription": "نحتاج الكاميرا لالتقاط صور إيصالات الدفع وصور المنتجات.",
        "NSPhotoLibraryUsageDescription": "نحتاج الوصول للصور لرفع إيصالات الدفع وصور المنتجات."
      },
      "associatedDomains": ["applinks:menu.smart-link.ly"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#010000"
      },
      "package": "ly.smartlink.smartmenu",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "menu.smart-link.ly" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Cairo-Regular.ttf",
            "./assets/fonts/Cairo-Bold.ttf",
            "./assets/fonts/Cairo-SemiBold.ttf",
            "./assets/fonts/ReadexPro-Regular.ttf",
            "./assets/fonts/ReadexPro-Bold.ttf"
          ]
        }
      ],
      "expo-secure-store",
      "expo-image-manipulator",
      "expo-image-picker",
      "expo-clipboard",
      "expo-sharing"
    ],
    "experiments": { "tsconfigPaths": true },
    "runtimeVersion": { "policy": "appVersion" },
    "updates": { "url": "" },
    "extra": { "eas": { "projectId": "" } }
  }
}
