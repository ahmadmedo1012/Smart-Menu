{
  "cli": { "version": ">= 15.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "development", "EXPO_PUBLIC_API_BASE_URL": "https://menu.smart-link.ly" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "APP_VARIANT": "preview", "EXPO_PUBLIC_API_BASE_URL": "https://menu.smart-link.ly" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "APP_VARIANT": "production", "EXPO_PUBLIC_API_BASE_URL": "https://menu.smart-link.ly" }
    }
  },
  "submit": { "production": {} }
}
