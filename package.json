{
  "name": "smart-menu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "clean": "rm -rf .next",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint --fix src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:legacy": "vitest run tests/unit --reporter=dot",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test tests/e2e tests/security",
    "webhook:register": "node scripts/register-webhook.mjs",
    "postbuild": "cp -r .next/static .next/standalone/.next/ 2>/dev/null || true"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@dotlottie/react-player": "^1.6.19",
