{
  "name": "smart-menu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/db-unstick.mjs && node scripts/migrate-deploy.mjs && prisma generate && next build",
    "start": "next start",
    "clean": "rm -rf .next",
    "lint": "eslint src/ tests/ scripts/ public/sw.js",
    "lint:fix": "eslint src/ tests/ scripts/ public/sw.js --fix",
    "typecheck": "tsc --noEmit",
    "test": "env -u DATABASE_URL vitest run",
    "test:watch": "env -u DATABASE_URL vitest",
    "test:coverage": "env -u DATABASE_URL vitest run --coverage",
    "test:e2e": "npx playwright test tests/e2e tests/security --project=security --project=api --project=ui --project=auth-verify",
    "webhook:register": "node scripts/register-webhook.mjs",
    "postbuild": "cp -r .next/static .next/standalone/.next/ 2>/dev/null || true; cp -r public .next/standalone/public 2>/dev/null || true",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node scripts/ci-seed.mjs",
    "knip": "knip",
    "verify": "pnpm author:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify:fast": "pnpm author:check && pnpm lint && pnpm typecheck && env -u DATABASE_URL pnpm exec vitest run --changed HEAD --passWithNoTests",
    "verify:mobile": "cd mobile && pnpm exec tsc --noEmit && pnpm run lint",
    "author:check": "node scripts/check-git-author.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.20.0",
    "motion": "^12.43.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.3.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "dotenv": "17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "knip": "5.46.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "description": "**منصة رقمية متكاملة لإدارة منيو المطاعم واستقبال الطلبات عبر واتساب**",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmadmedo1012/Smart-Menu.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ahmadmedo1012/Smart-Menu/issues"
  },
  "homepage": "https://github.com/ahmadmedo1012/Smart-Menu#readme",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
